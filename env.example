# plexusterm-relay — copy to .env (docker compose) or paste into the
# Portainer stack's environment variables. Never commit the real .env.
#   cp env.example .env

# ── Required ────────────────────────────────────────────────────────────

# Tokens that may create shares, comma-separated, 16+ characters each.
# PlexusTerm asks for one of them once, when you set up sharing.
# Generate one per device or person, so you can revoke one alone:
#   openssl rand -hex 32
# Revoke a token: remove it from this list and redeploy.
RELAY_TOKENS=

# Public WebSocket URL of the relay, as browsers and PlexusTerm reach it
# through your reverse proxy: wss:// + the DNS name you point at the
# relay (see deploy/nginx.conf). No path, no trailing slash.
# The viewer page only allows connections to this origin (CSP).
#   Example: wss://relay.example.com
RELAY_PUBLIC_URL=

# ── Optional ────────────────────────────────────────────────────────────

# Host ports the reverse proxy forwards to (Nginx Proxy Manager:
# Forward Hostname = the server's IP, Forward Port = these). Keep them
# closed in the firewall: only the proxy reaches them; the internet uses
# the proxy's 443. Change them if taken; check with:
#   ss -ltn | grep -E ':(33154|60689)'
RELAY_HOST_PORT=33154
VIEWER_HOST_PORT=60689

# Address the ports are published on. 0.0.0.0 lets a proxy running in
# another container reach them. Use 127.0.0.1 only when the proxy runs
# directly on the host (not in Docker).
HOST_BIND_IP=0.0.0.0

# Image to run from ghcr.io/jorgealonsodev/plexusterm-relay: `latest` follows
# main; a short commit (e.g. 93545b8) pins that exact build. The viewer
# footer and /build.txt show the commit the image was built from. Tags:
#   https://github.com/jorgealonsodev/plexusterm-relay/pkgs/container/plexusterm-relay
RELAY_IMAGE_TAG=latest

# 1: take the client IP from the last X-Forwarded-For entry, the one the
# reverse proxy adds (Nginx Proxy Manager, deploy/nginx.conf).
# Use 0 only if nothing sits in front of the relay.
RELAY_TRUST_PROXY=1

# Limits (PRD-share §5.5 defaults). A limit that is hit refuses the
# connection with a visible error; frames are never dropped.
RELAY_MAX_VIEWERS=10
RELAY_BYTES_PER_SEC=2097152
RELAY_JOINS_PER_MINUTE=20
RELAY_MAX_SHARES_PER_TOKEN=50
RELAY_VIEWER_QUEUE_BYTES=2097152

# Log level: error, warn, info, debug. Logs never contain share ids, IPs
# or terminal content.
RUST_LOG=info
